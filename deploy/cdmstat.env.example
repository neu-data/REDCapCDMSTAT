# Copy to /etc/cdmstat/cdmstat.env, owned by root:cdmstat, mode 0640.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# Data source: redcap | cloud | odm | demo
CDMSTAT_SOURCE=redcap
CDMSTAT_URL=https://redcap.example.org/api/
CDMSTAT_TOKEN_ENV=REDCAP_API_TOKEN
REDCAP_API_TOKEN=replace-with-the-service-account-token

# Cache, ledger, cuts: keep on an encrypted volume, backed up daily.
CDMSTAT_DIR=/var/lib/cdmstat/project

# Gateway
CDMSTAT_R_API=http://127.0.0.1:8000
CDMSTAT_GATEWAY_SECRET=replace-with-64-hex-chars
CDMSTAT_DET_TOKEN=replace-with-64-hex-chars
CDMSTAT_USERS_FILE=/var/lib/cdmstat/users.json
