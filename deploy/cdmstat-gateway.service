# systemd unit for the CDMSTAT FastAPI gateway.
[Unit]
Description=REDCap CDMSTAT gateway (FastAPI, behind HTTPS reverse proxy)
After=network-online.target cdmstat-api.service
Requires=cdmstat-api.service

[Service]
User=cdmstat
Group=cdmstat
EnvironmentFile=/etc/cdmstat/cdmstat.env
WorkingDirectory=/opt/cdmstat/web/gateway
ExecStart=/opt/cdmstat/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8080 --proxy-headers --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cdmstat
UMask=0077

[Install]
WantedBy=multi-user.target
